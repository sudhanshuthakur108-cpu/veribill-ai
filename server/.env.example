# Copy to server/.env for local overrides. Never commit real credentials.

# Port the API listens on. If you change it, update API_PROXY_TARGET in client/.env.
PORT=4000

# "production" turns on Secure cookies and makes MONGODB_URI required.
NODE_ENV=development

# MongoDB connection string. The default matches `npm run db`.
# Put real credentials only in server/.env, never in this example file.
MONGODB_URI=mongodb://127.0.0.1:27017/veribill

# How long a sign-in lasts before the user must sign in again (hours, max 720).
SESSION_TTL_HOURS=8

# Comma-separated browser origins allowed to make state-changing requests when the
# browser does not send Sec-Fetch-Site. Same-origin requests through the Vite proxy
# do not need an entry. Example: http://localhost:5173
TRUSTED_ORIGINS=
