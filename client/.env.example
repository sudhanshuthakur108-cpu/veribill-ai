# Copy to client/.env for local overrides.
#
# Only variables prefixed with VITE_ are bundled into browser code, and anything
# bundled is public. Never put secrets or API keys in this file; they belong in
# server/.env and should be used only by the API.

# Where the Vite dev and preview servers forward /api requests. Read by
# vite.config.js only, so it is not exposed to the browser.
API_PROXY_TARGET=http://localhost:4000
